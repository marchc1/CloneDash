<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<IsWindows>$([MSBuild]::IsOSPlatform('Windows'))</IsWindows>
		<IsOSX>$([MSBuild]::IsOSPlatform('OSX'))</IsOSX>
		<IsLinux>$([MSBuild]::IsOSPlatform('Linux'))</IsLinux>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsWindows)' == 'true'">
		<DefineConstants>$(DefineConstants);COMPILED_WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsOSX)' == 'true'">
		<DefineConstants>$(DefineConstants);COMPILED_OSX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsLinux)' == 'true'">
		<DefineConstants>$(DefineConstants);COMPILED_LINUX</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.7" />
		<PackageReference Include="Microsoft.Diagnostics.Runtime" Version="4.0.732401" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="Velopack" Version="0.0.1298" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AssetStudioUtility\AssetStudioUtility.csproj" />
		<ProjectReference Include="..\AssetStudio\AssetStudio.csproj" />
		<ProjectReference Include="..\Fmod5Sharp\Fmod5Sharp.csproj" />
		<ProjectReference Include="..\Nucleus.FileSystem\Nucleus.FileSystem.csproj" />
		<ProjectReference Include="..\Nucleus\Nucleus.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\StandardComponents.cs" Link="Usings\Globals\StandardComponents.cs" />
		<Compile Include="..\GlobalUsings.cs" Link="Usings\Globals\GlobalUsings.cs" />
	</ItemGroup>
</Project>
