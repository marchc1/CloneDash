<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>Clone Dash</AssemblyName>
		<RootNamespace>CloneDash</RootNamespace>
		<ApplicationIcon>cdicon.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup>
		<IsWindows>$([MSBuild]::IsOSPlatform('Windows'))</IsWindows>
		<IsOSX>$([MSBuild]::IsOSPlatform('OSX'))</IsOSX>
		<IsLinux>$([MSBuild]::IsOSPlatform('Linux'))</IsLinux>
	</PropertyGroup>

	<PropertyGroup>
		<SourceRevisionId>build$([System.DateTime]::UtcNow.ToString("yyyy-MM-ddTHH:mm:ss:fffZ"))</SourceRevisionId>
	</PropertyGroup>

	<PropertyGroup Condition="'$(IsWindows)' == 'true'">
		<DefineConstants>$(DefineConstants);COMPILED_WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsOSX)' == 'true'">
		<DefineConstants>$(DefineConstants);COMPILED_OSX</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(IsLinux)' == 'true'">
		<DefineConstants>$(DefineConstants);COMPILED_LINUX</DefineConstants>
	</PropertyGroup>


	<ItemGroup>
	  <Content Include="cdicon.ico" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
		<PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
		<PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.7" />
		<PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
		<PackageReference Include="Velopack" Version="0.0.1298" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\AssetStudioUtility\AssetStudioUtility.csproj" />
		<ProjectReference Include="..\AssetStudio\AssetStudio.csproj" />
		<ProjectReference Include="..\CloneDash.Common\CloneDash.Common.csproj" />
		<ProjectReference Include="..\CloneDash.MuseDash1Compatibility\CloneDash.MuseDash1Compatibility.csproj" />
		<ProjectReference Include="..\Fmod5Sharp\Fmod5Sharp.csproj" />
		<ProjectReference Include="..\Nucleus\Nucleus.csproj" />
		<ProjectReference Include="..\OdinSerializer\OdinSerializer.csproj" />
	</ItemGroup>


	<Import Project="..\StandardComponents.targets" />
	<Import Project="..\Nucleus\NucleusAssets.targets" />

	<ItemGroup>
		<Compile Include="..\GlobalUsings.cs" Link="Usings\Globals\GlobalUsings.cs" />
	</ItemGroup>


	<Target Name="GenerateBuildDate" BeforeTargets="CoreCompile">
		<PropertyGroup>
			<BuildDateUtc>$([System.DateTime]::UtcNow.ToString("O"))</BuildDateUtc>
			<GeneratedCode>
				namespace CloneDash%3B

				public static class BuildInfo
				{
				public const string BuildDate = "$(BuildDateUtc)"%3B
				}
			</GeneratedCode>
		</PropertyGroup>
		<WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.generated.cs" Lines="$(GeneratedCode)" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<ItemGroup>
			<Compile Include="$(IntermediateOutputPath)BuildInfo.generated.cs" />
		</ItemGroup>
	</Target>

	<Target Name="CopyBuildAssets" AfterTargets="Build">
		<ItemGroup>
			<UniversalAssets Include="$(MSBuildThisFileDirectory)BuildAssets\universal\**\*" />
			<PlatformAssets Condition="'$(IsWindows)' == 'true'" Include="$(MSBuildThisFileDirectory)BuildAssets\winnt\**\*" />
			<PlatformAssets Condition="'$(IsOSX)' == 'true'" Include="$(MSBuildThisFileDirectory)BuildAssets\intel_osx\**\*" />
			<PlatformAssets Condition="'$(IsLinux)' == 'true'" Include="$(MSBuildThisFileDirectory)BuildAssets\linux\**\*" />
		</ItemGroup>

		<Copy SourceFiles="@(UniversalAssets)" DestinationFolder="$(OutDir)%(RecursiveDir)" SkipUnchangedFiles="true" />

		<Copy SourceFiles="@(PlatformAssets)" DestinationFolder="$(OutDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>
	
	<Target Name="CopyPublishAssets" AfterTargets="Publish">
		<ItemGroup>
			<UniversalAssets Include="$(MSBuildThisFileDirectory)BuildAssets\universal\**\*" />
			<PlatformAssets Condition="'$(IsWindows)' == 'true'" Include="$(MSBuildThisFileDirectory)BuildAssets\winnt\**\*" />
			<PlatformAssets Condition="'$(IsOSX)' == 'true'" Include="$(MSBuildThisFileDirectory)BuildAssets\intel_osx\**\*" />
			<PlatformAssets Condition="'$(IsLinux)' == 'true'" Include="$(MSBuildThisFileDirectory)BuildAssets\linux\**\*" />
		</ItemGroup>

		<Copy SourceFiles="@(UniversalAssets)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
		<Copy SourceFiles="@(PlatformAssets)" DestinationFolder="$(PublishDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>

</Project>